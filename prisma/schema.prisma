generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  industry  String?
  settings  Json?
  
  users       User[]
  competitors Competitor[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String?
  role         Role         @default(VIEWER)
  
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId])
}

model Competitor {
  id        String   @id @default(uuid())
  name      String
  domain    String?
  logoText  String
  logoColor String
  industry  String?
  status    String
  score     Int      @default(0)
  
  orgId     String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, name])
}

model Product {
  id           String     @id @default(uuid())
  name         String
  description  String?
  
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  
  features     Feature[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([competitorId])
}

model Feature {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String
  
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

